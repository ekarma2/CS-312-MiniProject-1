<!DOCTYPE html>
<html>
<head>
   
    <!--Bootstrap CSS-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!--Header-->
    <%- include('header')%>
</head>
<body>

    <h1>Edit Post</h1>
    <!--Get specific post off ID-->
    <form action ="/posts/<%= post.id %>?_method=PUT" method="POST">
        <!--Fill with post content-->
        <label>Author:</label>
        <input type="text" name="author" value="<%= post.author %>" required><br>
        <label>Title:</label>
        <input type="text" name="title" value="<%= post.title %>" required><br>
        <label>Body:</label>
        <textarea name="body" required><%= post.body %></textarea><br>

        <button type="submit">Save Changes</button>
    </form>
    </div>
</body>
</html>