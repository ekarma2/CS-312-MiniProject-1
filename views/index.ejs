<!DOCTYPE html>
<html>
<head>
    <title>Blog</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <!--Header-->
    <%- include('header')%>
<!--Posts-->
      <div class="container">
        <a href="/posts/new" class="btn btn-outline-primary mb-4">+ New Post</a>
        
        <!--Iterate through posts, show newest first-->
        <% posts.slice().reverse().forEach(post => { %>
            <div class="card mb-1">
                <div class="card-body">
            <!--Post Content-->
            <h2><%= post.title %></h2>
            <p><%= post.body %></p>
            <p>Author: <%= post.author %></p>
            <!--Display time of post-->
            <p>Created: <%= post.createdAt.toLocaleString() %></p>
            <!--Edit button-->
            <a href="/posts/<%= post.id %>/edit">Edit</a>
            <!--Delete button-->
            <form action="/posts/<%= post.id %>/delete" method="POST">
                <button type="submit">Delete</button>
            </form>
        </div>
        <% }) %>
    </div>
</body>
</html>
