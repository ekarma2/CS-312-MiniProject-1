<!DOCTYPE html>
<html>
<head>
    <title>Blog</title>
    <!--Stylesheet-->
    <link rel="stylesheet" href="/style.css">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<!--Header-->
<nav class="navbar navbar-dark bg-dark mb-4">
  <div class="container mt-4">
    <span class="navbar-brand mb-4">
      <h1>My Blog</h1>
    </span>
  </div>
</nav>
<!--Posts-->
      <div class="container">
        <a href="/posts/new" class="btn btn-outline-primary mb-4">+ New Post</a>
        
        <!--Iterate through posts-->
        <% posts.forEach(post => { %>
            <div class="card mb-3">
                <div class="card-body">
            <!--Post Content-->
            <h2><%= post.title %></h2>
            <p><%= post.body %></p>
            <p>Author: <%= post.author %></p>
            <!--Edit button-->
            <a href="/posts/<%= post.id %>/edit">Edit</a>
            <!--Delete button-->
            <form action="/posts/<%= post.id %>/delete" method="POST">
                <button type="submit">Delete</button>
            </form>
        </div>
        <% }) %>
    </div>
</body>
</html>
